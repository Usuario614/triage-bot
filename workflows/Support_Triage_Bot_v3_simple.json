        "googleSheetsOAuth2Api": {
          "id": "nJW6UWvQHViCBv2d",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Tomamos los últimos 7 días\nconst hoy = new Date();\nconst haceUnaSemana = new Date(hoy);\nhaceUnaSemana.setDate(hoy.getDate() - 7);\n\nconst items = $input.all();\n\nconst ticketsSemana = items.filter(item => {\n  const fecha = item.json.Fecha;\n  if (!fecha) return false;\n  const f = new Date(fecha);\n  return f >= haceUnaSemana && f <= hoy;\n});\n\nconst total = ticketsSemana.length;\nconst urgentes = ticketsSemana.filter(t => Number(t.json.Prioridad) >= 4).length;\nconst sinClasificar = ticketsSemana.filter(t => t.json['Rev Manual'] && t.json['Rev Manual'].toString().trim() !== '').length;\n\nconst porCanal = {};\nticketsSemana.forEach(t => {\n  const canal = t.json.Canal || 'desconocido';\n  porCanal[canal] = (porCanal[canal] || 0) + 1;\n});\n\nconst porSentimiento = {};\nticketsSemana.forEach(t => {\n  const sent = t.json.Sentimiento || 'desconocido';\n  porSentimiento[sent] = (porSentimiento[sent] || 0) + 1;\n});\n\nconst fechaInicioStr = haceUnaSemana.toISOString().split('T')[0];\nconst fechaFinStr = hoy.toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    fecha: `${fechaInicioStr} al ${fechaFinStr}`,\n    total,\n    urgentes,\n    sinClasificar,\n    porCanal,\n    porSentimiento,\n    tickets: ticketsSemana.map(t => t.json)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        560
      ],
      "id": "ec95ae42-0a93-461f-8c83-00bd1f473b03",
      "name": "Code in JavaScript Semanal"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst filasCanal = Object.entries(data.porCanal || {})\n  .map(([canal, cant]) => `<tr><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">${canal}</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;text-align:right;\">${cant}</td></tr>`)\n  .join('');\n\nconst filasSentimiento = Object.entries(data.porSentimiento || {})\n  .map(([sent, cant]) => `<tr><td style=\"padding:8px 12px;border-bottom:1px solid #eee;\">${sent}</td><td style=\"padding:8px 12px;border-bottom:1px solid #eee;text-align:right;\">${cant}</td></tr>`)\n  .join('');\n\nconst html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333;\">\n  <div style=\"background-color: #0b5d3b; padding: 24px; border-radius: 8px 8px 0 0;\">\n    <h1 style=\"color: #ffffff; margin: 0; font-size: 22px;\">📊 Reporte Semanal de Soporte</h1>\n    <p style=\"color: #d5e8dd; margin: 6px 0 0 0; font-size: 14px;\">Semana del ${data.fecha}</p>\n  </div>\n\n  <div style=\"border: 1px solid #e0e0e0; border-top: none; padding: 24px; border-radius: 0 0 8px 8px;\">\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 24px;\">\n      <tr>\n        <td style=\"text-align: center; padding: 12px; background: #f5f5f5; border-radius: 6px;\">\n          <div style=\"font-size: 26px; font-weight: bold; color: #0b5d3b;\">${data.total}</div>\n          <div style=\"font-size: 12px; color: #777;\">Tickets totales</div>\n        </td>\n        <td style=\"width: 12px;\"></td>\n        <td style=\"text-align: center; padding: 12px; background: #fdeaea; border-radius: 6px;\">\n          <div style=\"font-size: 26px; font-weight: bold; color: #c0392b;\">${data.urgentes}</div>\n          <div style=\"font-size: 12px; color: #777;\">Urgentes</div>\n        </td>\n        <td style=\"width: 12px;\"></td>\n        <td style=\"text-align: center; padding: 12px; background: #fff8e1; border-radius: 6px;\">\n          <div style=\"font-size: 26px; font-weight: bold; color: #b8860b;\">${data.sinClasificar}</div>\n          <div style=\"font-size: 12px; color: #777;\">Sin clasificar</div>\n        </td>\n      </tr>\n    </table>\n\n    <h3 style=\"font-size: 15px; color: #0b5d3b; margin-bottom: 8px;\">Distribución por canal</h3>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n      ${filasCanal || '<tr><td style=\"padding:8px 12px;color:#999;\">Sin datos</td></tr>'}\n    </table>\n\n    <h3 style=\"font-size: 15px; color: #0b5d3b; margin-bottom: 8px;\">Distribución por sentimiento</h3>\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      ${filasSentimiento || '<tr><td style=\"padding:8px 12px;color:#999;\">Sin datos</td></tr>'}\n    </table>\n\n    <p style=\"text-align: center; margin-top: 16px;\">\n      <a href=\"https://docs.google.com/spreadsheets/d/1MtOhCwH04kSzLU8CC2oNJT2JjFWHQmvZIUroPFy4kGA/edit\" style=\"color: #0b5d3b; font-size: 13px; text-decoration: none; font-weight: bold;\">\n        Ver todos los tickets en la planilla →\n      </a>\n    </p>\n\n    <p style=\"font-size: 12px; color: #aaa; margin-top: 24px; text-align: center;\">\n      Generado automáticamente por Support Triage Bot\n    </p>\n  </div>\n</div>\n`;\n\nreturn [{\n  json: {\n    ...data,\n    html: html,\n    subject: `Reporte Semanal de Soporte - ${data.fecha}`\n  }\n}];"
      },
